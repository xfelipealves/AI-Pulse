{
  "name": "ai-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "A local macOS menu bar monitor for Codex usage limits.",
  "author": "Felipe Alves",
  "main": "out/main/main.js",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfelipealves/AI-Pulse.git"
  },
  "bugs": {
    "url": "https://github.com/xfelipealves/AI-Pulse/issues"
  },
  "homepage": "https://github.com/xfelipealves/AI-Pulse#readme",
  "keywords": [
    "codex",
    "electron",
    "local-first",
    "macos",
    "menu-bar",
    "tray",
    "usage-monitor"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "electron-vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.felipe.ai-pulse",
    "productName": "AI Pulse",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/ai-pulse.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
